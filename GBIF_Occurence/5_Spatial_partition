  abcrop$presence<-1
  
  current_lowres <- aggregate(current, fact = 10, fun = "mean")
  
  #pseudo absence
  pa_arabis <- sample_pseudoabs(data = abcrop,
                                x="lon", 
                                y="lat",
                                n=nrow(abcrop)*1,
                                method=c('kmeans', env=current_lowres),
                                rlayer = (current_lowres[[1]])
  )
    
  pa_arabis2<-rename(pa_arabis, presence=pr_ab)
  
  head(abcrop)
  head(pa_arabis2)
  
  pa_arabis2$species<-"arabis"
  pa_arabis2$group<-"pseudo"
  
  abcrop_new<-rbind(abcrop, pa_arabis2)
  
  head(abcrop_new)
  
  # Partition data with SPATIAL methods
  
