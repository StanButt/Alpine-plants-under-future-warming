## Create Forecast Models ####

direct1<-paste0(hdd_local, "/Layers/Forecast/chelsa_crop")

plan(multisession, workers = 4)  

# Adjust workers based on  CPU 
options(future.globals.maxSize = 12 * 1024^3)

options(timeout = 600) 
getOption("timeout")

# export model and only load in required one
  
  future_lapply(years, function(year) {

    save_path<-paste0(hdd_local, "/Data/rf_modelv2.rds")
    raf_ab<-readRDS(save_path)
  
  for(proj in ssp){
spat_list<-list()

    for(bio in bioclim_layers){

      direct2<-path(direct1, year, bio, proj)

      ras<-rast(paste0(direct2, "/", bio, "_mcrop_v2.tif"))

      spat_list[[bio]]<-ras
      
    }
cat("\n", proj, year, "\n")

forecast_pred <- sdm_predict(
  models = raf_ab,
  pred = spat_list,  # SpatRaster
  thr = "max_sens_spec",
  con_thr = FALSE
)

  fore_rast<-forecast_pred$raf$raf
  fore_max<-forecast_pred$raf$max_sens_spec
  
    
  writeRaster(fore_rast, filename=paste0(proj_save, "/Projected/", year, proj, "_v2.tif"))
  writeRaster(fore_max, filename=paste0(proj_save, "/Projected/max_", year, proj,  "_v2.tif"))
  saveRDS(forecast_pred, file = paste0(proj_save, "/Projected/", year, proj, "_sdm_v2.rds"))
  }

  
})
  


