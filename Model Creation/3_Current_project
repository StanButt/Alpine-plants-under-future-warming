# Calculate suitable habitat area ####

bin<-rast(paste0(proj_save, "/max_rast.tif"))
cbin_mask <- ifel(bin == 1, 1, NA)

abcrop2<-abcrop
coordinates(abcrop2) <- ~lon+lat
proj4string(abcrop2) <- CRS("+proj=longlat +datum=WGS84")


polyab <- as.polygons(vect(abcrop2, type="lines"))
polyab<-vect(abcrop2, type="lines")
polyab <- hull(polyab, type="concave_length")

# Buffer width should be in m. adding 1.5km for dispersal buffer
polyab <- project(polyab, "EPSG:3035")
polyab<-buffer(polyab, 1500)

#reproject back
polyab <- project(polyab, crs(bin))

csdm_mask <- terra::mask(cbin_mask, polyab)
csdm_mask_i <- terra::mask(cbin_mask, polyab, inverse=TRUE)

pol <- as.polygons(csdm_mask, dissolve = TRUE)
pol_i <- as.polygons(csdm_mask_i, dissolve = TRUE)


maskall<-mask(curr_rast, pol, updatevalue=0)
maskdiff<-mask(curr_rast, pol_i, updatevalue=0)

mask_bin1<-maskall>0
mask_bin2<-maskdiff>0

cell_area1 <- terra::cellSize(maskall, unit = "km")
cell_area2 <- terra::cellSize(maskdiff, unit = "km")

habitat_area <- sum(values(cell_area1)[values(mask_bin1) == 1], na.rm = TRUE)
habitat_diff <- sum(values(cell_area2)[values(mask_bin2) == 1], na.rm = TRUE)

total_suit<-habitat_area+habitat_diff
within_suit<-habitat_area
difference<-habitat_diff
