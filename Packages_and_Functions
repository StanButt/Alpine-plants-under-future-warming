# Functions used throughout

clean_raster_names <- function(raster_stack, patterns) {
    names_stack <- names(raster_stack)
    for (pattern in patterns) {
      names_stack <- sub(pattern, "", names_stack)
    }
    names(raster_stack) <- names_stack
    return(raster_stack)}
  

keep_layers <- function(env, environ) {
    all_layers <- names(env)
    layers_to_keep <- intersect(all_layers, environ)
    env <- env[[layers_to_keep]]}
  
